# Kopiere diese Datei nach .env.local und passe die Werte lokal an. .env.local wird nicht committet.

# Dev-only: true = Buchungsanfrage wird nicht gesendet, die Erfolgsansicht erscheint stattdessen.
# Wirkt nur bei npm run dev, in Produktions-Builds ist der Schalter immer aus.
VITE_MOCK_BOOKING=false
